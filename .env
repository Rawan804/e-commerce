# Local environment for development.
# Copy values from .env.example. Never commit real secrets.
# Variables must start with VITE_ to be exposed to the browser bundle.

# Base URL for the Laravel API — no trailing slash.
# The UI works without a running backend: products fall back to bundled demo
# data and auth runs in demo mode when the API is unreachable.
VITE_API_BASE_URL=http://localhost:9000/api/v1
VITE_USE_MOCK=false
